#!/usr/bin/env python3
"""
WebDanışmanı — Security Audit

Installs to: /usr/local/hestia/wd/bin/wd-guvenlik

WHAT IT DOES
  Continuously audits the server's security posture and applies fixes in a
  GUARDED way. Same pattern as Health Center: collector writes cache, panel
  reads cache, alert layer turns findings into notifications.

AUDITED
  SSH        root login, password login, key presence, MaxAuthTries
  Panel      2FA, API exposure, CSRF policy
  Attacks    fail2ban jail health, current bans, top probing IPs
  System     pending security updates
  PHP        end-of-life versions installed / in use
  Files      world-writable files under web roots
  Services   unnecessary open ports (plain FTP, etc.)

WHY HARDENING IS "GUARDED"
  Disabling SSH password login with no working key on the server loses access
  COMPLETELY. Every hardening action therefore checks its precondition first
  and REFUSES to run if unmet. After writing sshd config, `sshd -t` validates;
  on failure the old state is restored and `reload` is used (existing sessions
  stay up).

Usage:
  wd-guvenlik refresh              run audit, write cache (cron)
  wd-guvenlik json | plain
  wd-guvenlik uygula <islem>       apply hardening
      ssh-parola-kapat    disable SSH password login (key required)
      ssh-root-kapat      disable direct root login (sudo user required)
      ftp-kapat           stop and disable plain FTP
      eol-php-kaldir      remove unused EOL PHP versions
  wd-guvenlik uygula <islem> --kuru   print what would be done, do not apply
"""

import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time

import sys as _wd_sys
_wd_lib = "/usr/local/hestia/wd/lib"
if _wd_lib not in _wd_sys.path:
    _wd_sys.path.insert(0, _wd_lib)
_wd_pkg = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib")
if os.path.isdir(_wd_pkg) and _wd_pkg not in _wd_sys.path:
    _wd_sys.path.insert(0, _wd_pkg)
from wd_i18n import _, ngettext  # noqa: E402
N_ = lambda s: s  # mark for .po extract; translate in PHP (cached JSON)

HESTIA = "/usr/local/hestia"
CACHE = HESTIA + "/wd/cache/guvenlik.json"
SSHD = "/etc/ssh/sshd_config"
SSHD_WD = "/etc/ssh/sshd_config.d/99-webdanismani.conf"

# Desteği bitmiş PHP sürümleri (güvenlik yaması almazlar).
EOL_PHP = ["5.6", "7.0", "7.1", "7.2", "7.3", "7.4", "8.0"]

# Sunucunun işi gereği açık olması beklenen portlar.
BEKLENEN_PORT = {22, 25, 53, 80, 443, 143, 993, 110, 995, 465, 587, 8083, 4190}


def kabuk(cmd, timeout=60):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True,
                           timeout=timeout, check=False)
        return r.returncode, r.stdout, r.stderr
    except Exception as e:
        return 1, "", str(e)


def kontrol(kid, label, durum, deger="", note="", cozum="", islem=None):
    return {"id": kid, "label": label, "durum": durum, "deger": deger,
            "not": note, "cozum": cozum, "islem": islem}


# ------------------------------------------------------------------ ssh
def sshd_ayar(anahtar):
    """
    sshd'nin GERÇEKTE kullandığı değeri döner.

    Dosyaları elle okumak yanıltır: sshd_config.d/*.conf dosyaları ve
    "ilk tanım kazanır" kuralı vardır. `sshd -T` çözülmüş yapılandırmayı
    verir; doğruluk kaynağı budur.
    """
    rc, out, _ = kabuk(["sshd", "-T"])
    if rc != 0:
        return None
    for satir in out.splitlines():
        p = satir.split(None, 1)
        if len(p) == 2 and p[0].lower() == anahtar.lower():
            return p[1].strip()
    return None


GECERSIZ_KABUK = ("/usr/sbin/nologin", "/sbin/nologin", "/bin/false", "/usr/bin/false")


def kabuk_gecerli(kullanici):
    """
    Hesap SSH ile GERÇEKTEN giriş yapabiliyor mu?

    Anahtarın varlığı yetmez: kabuk `nologin` ise anahtar işe yaramaz.
    (Ölçüldü: `admin` hesabında sudo ve anahtar var ama kabuğu nologin —
    yalnızca anahtara bakan bir denetim burada kilitlenmeye yol açardı.)
    """
    rc, out, _ = kabuk(["getent", "passwd", kullanici])
    if rc != 0 or not out.strip():
        return False
    kabuk_yolu = out.strip().split(":")[-1]
    return kabuk_yolu not in GECERSIZ_KABUK


def sudo_yetkili(kullanici):
    rc, out, _ = kabuk(["sudo", "-l", "-U", kullanici])
    return rc == 0 and ("(ALL)" in out or "NOPASSWD" in out)


def ssh_anahtarlari(yalniz_girisebilen=False):
    """
    SSH anahtarı olan hesaplar: {kullanici: anahtar sayisi}

    `yalniz_girisebilen=True` iken kabuğu geçersiz olan hesaplar ELENİR;
    sertleştirme ön koşulları bu listeyi kullanmalıdır.
    """
    sonuc = {}
    yollar = ["/root/.ssh/authorized_keys"] + glob.glob("/home/*/.ssh/authorized_keys")
    for y in yollar:
        try:
            with open(y, encoding="utf-8", errors="replace") as fh:
                n = len([s for s in fh if s.strip() and not s.startswith("#")])
            kullanici = "root" if y.startswith("/root") else y.split("/")[2]
            if not n:
                continue
            if yalniz_girisebilen and not kabuk_gecerli(kullanici):
                continue
            sonuc[kullanici] = n
        except Exception:
            continue
    return sonuc


def ssh_kontrolleri():
    ck = []
    anahtarlar = ssh_anahtarlari()
    toplam_anahtar = sum(anahtarlar.values())

    parola = (sshd_ayar("passwordauthentication") or "").lower()
    root = (sshd_ayar("permitrootlogin") or "").lower()
    maxauth = sshd_ayar("maxauthtries")

    # --- Anahtar durumu: diğer kontrollerin ön koşulu ---
    if not anahtarlar:
        ck.append(kontrol(
            "ssh_anahtar", N_("SSH key"), "warn", N_("none"),
            N_("No account has an SSH key configured."),
            N_("Add a key BEFORE disabling password login: "
              "ssh-copy-id root@server"),
        ))
    else:
        ck.append(kontrol(
            "ssh_anahtar", N_("SSH key"), "ok",
            ", ".join("%s(%d)" % (k, v) for k, v in sorted(anahtarlar.items())),
        ))

    # --- Parola girişi ---
    if parola == "yes":
        ck.append(kontrol(
            "ssh_parola", N_("SSH password login"), "fail", N_("enabled"),
            N_("Server accepts password attempts; a target for brute-force attacks."),
            N_("Disable password login if key-based login works.")
            if toplam_anahtar else
            N_("FIRST add your own SSH key, then disable password login."),
            "ssh-parola-kapat" if toplam_anahtar else None,
        ))
    else:
        ck.append(kontrol("ssh_parola", N_("SSH password login"), "ok", N_("disabled")))

    # --- root girişi ---
    if root in ("yes", "prohibit-password", "without-password"):
        seviye = "warn" if root != "yes" else "fail"
        ck.append(kontrol(
            "ssh_root", N_("SSH root login"), seviye,
            N_("enabled") if root == "yes" else N_("key-only"),
            N_("The root account can be targeted directly.")
            if root == "yes" else
            N_("Root can log in with a key; not with a password."),
            N_("Create a separate sudo-capable user and disable root login."),
            "ssh-root-kapat" if root == "yes" else None,
        ))
    else:
        ck.append(kontrol("ssh_root", N_("SSH root login"), "ok", N_("disabled")))

    if maxauth and maxauth.isdigit() and int(maxauth) > 4:
        ck.append(kontrol("ssh_maxauth", N_("Attempt limit"), "warn", maxauth,
                          N_("Allowed attempts per connection is high."),
                          N_("Set MaxAuthTries 4 in sshd_config.")))
    return ck


# ------------------------------------------------------------- fail2ban
def fail2ban_kontrolleri():
    ck = []
    rc, out, _ = kabuk(["fail2ban-client", "status"])
    if rc != 0:
        return [kontrol("f2b", "fail2ban", "fail", N_("not running"),
                        N_("Brute-force protection is disabled."),
                        "systemctl enable --now fail2ban")]

    m = re.search(r"Jail list:\s*(.*)", out)
    jailler = [j.strip() for j in (m.group(1) if m else "").split(",") if j.strip()]
    simdi = toplam = 0
    for j in jailler:
        _, o, _ = kabuk(["fail2ban-client", "status", j])
        a = re.search(r"Currently banned:\s*(\d+)", o)
        b = re.search(r"Total banned:\s*(\d+)", o)
        simdi += int(a.group(1)) if a else 0
        toplam += int(b.group(1)) if b else 0

    ck.append(kontrol("f2b", "fail2ban", "ok",
                      N_("%d jails · %d active bans · %d total")
                      % (len(jailler), simdi, toplam)))
    return ck


def saldirganlar(adet=8):
    """En çok başarısız SSH denemesi yapan IP'ler."""
    sayac = {}
    for yol in ("/var/log/auth.log", "/var/log/secure"):
        if not os.path.isfile(yol):
            continue
        try:
            with open(yol, encoding="utf-8", errors="replace") as fh:
                for s in fh:
                    if "Failed password" not in s and "Invalid user" not in s:
                        continue
                    m = re.search(r"from ([0-9a-fA-F:.]+)", s)
                    if m:
                        sayac[m.group(1)] = sayac.get(m.group(1), 0) + 1
        except Exception:
            continue
    return sorted([{"ip": k, "deneme": v} for k, v in sayac.items()],
                  key=lambda x: -x["deneme"])[:adet]


# --------------------------------------------------------------- panel
def panel_kontrolleri():
    ck = []
    rc, out, _ = kabuk([HESTIA + "/bin/v-list-sys-config", "json"])
    cfg = {}
    try:
        cfg = (json.loads(out) or {}).get("config", {})
    except Exception:
        pass

    # --- 2FA ---
    rc, out, _ = kabuk([HESTIA + "/bin/v-list-users", "json"])
    try:
        kullanicilar = json.loads(out) if out else {}
    except ValueError:
        kullanicilar = {}
    yoneticiler = [u for u, v in kullanicilar.items() if v.get("ROLE") == "admin"]
    twofa_yok = []
    for u in yoneticiler:
        try:
            with open("%s/data/users/%s/user.conf" % (HESTIA, u),
                      encoding="utf-8") as fh:
                icerik = fh.read()
            m = re.search(r"TWOFA='([^']*)'", icerik)
            if not m or not m.group(1).strip():
                twofa_yok.append(u)
        except Exception:
            continue

    if twofa_yok:
        ck.append(kontrol(
            "twofa", N_("Panel 2FA"), "fail", N_("off: ") + ", ".join(twofa_yok),
            N_("Admin account is protected by password only; the panel is exposed."),
            N_("Panel > Account Settings > enable Two-Factor Authentication."),
        ))
    elif yoneticiler:
        ck.append(kontrol("twofa", N_("Panel 2FA"), "ok",
                          N_("enabled for all admins")))

    # --- API ---
    api = cfg.get("API", "")
    izin = (cfg.get("API_ALLOWED_IP") or "").strip()
    if api == "yes" and izin == "":
        # Boş liste HestiaCP'de "hiç kimse" demektir — açık DEĞİL.
        ck.append(kontrol("api", N_("API access"), "ok",
                          N_("enabled but IP list empty (nobody can connect)")))
    elif api == "yes" and ("0.0.0.0" in izin):
        ck.append(kontrol(
            "api", N_("API access"), "fail", N_("open to everyone"),
            N_("API is open to the world via 0.0.0.0."),
            "v-change-sys-config-value API_ALLOWED_IP 'MAGAZA_IP'",
        ))
    elif api == "yes":
        ck.append(kontrol("api", N_("API access"), "ok",
                          N_("restricted: ") + izin))
    else:
        ck.append(kontrol("api", N_("API access"), "ok", N_("disabled")))

    if cfg.get("POLICY_CSRF_STRICTNESS", "1") != "1":
        ck.append(kontrol("csrf", N_("CSRF protection"), "warn", N_("relaxed"),
                          N_("Panel CSRF checks are not at full strictness."),
                          "v-change-sys-config-value POLICY_CSRF_STRICTNESS '1'"))
    return ck


# -------------------------------------------------------------- sistem
def guncelleme_kontrolu():
    rc, out, _ = kabuk(["apt-get", "-s", "upgrade"], timeout=120)
    if rc != 0:
        return [kontrol("guncelleme", N_("Updates"), "bilinmiyor",
                        N_("could not check"))]
    satirlar = [s for s in out.splitlines() if s.startswith("Inst ")]
    guvenlik = [s for s in satirlar if "security" in s.lower()]
    if guvenlik:
        return [kontrol(
            "guncelleme", N_("Security updates"), "fail",
            ngettext("%d package", "%d packages", len(guvenlik)) % len(guvenlik),
            N_("Published security patches are not installed."),
            N_("On the server: apt-get update && apt-get upgrade"),
        )]
    if satirlar:
        return [kontrol("guncelleme", N_("Updates"), "warn",
                        ngettext("%d package (non-security)",
                                 "%d packages (non-security)",
                                 len(satirlar)) % len(satirlar),
                        N_("There are pending updates."))]
    return [kontrol("guncelleme", N_("Updates"), "ok", N_("up to date"))]


def php_kontrolu():
    kurulu = sorted(os.listdir("/etc/php")) if os.path.isdir("/etc/php") else []
    eol_kurulu = [v for v in kurulu if v in EOL_PHP]
    if not eol_kurulu:
        return [kontrol("php_eol", N_("PHP versions"), "ok", ", ".join(kurulu))]

    # Kullanımda mı? Kullanılmayan EOL sürüm düşük risktir ama kaldırılmalıdır.
    kullanan = []
    for v in eol_kurulu:
        desen = "PHP-" + v.replace(".", "_")
        rc, out, _ = kabuk(["bash", "-c",
                            "grep -l %s %s/data/users/*/web.conf 2>/dev/null | wc -l"
                            % (desen, HESTIA)])
        if out.strip() not in ("", "0"):
            kullanan.append(v)

    if kullanan:
        return [kontrol(
            "php_eol", N_("End-of-life PHP"), "fail", ", ".join(kullanan),
            N_("These versions no longer receive security patches and are used on live sites."),
            N_("Move sites to a current PHP version."),
        )]
    return [kontrol(
        "php_eol", N_("End-of-life PHP"), "warn", ", ".join(eol_kurulu),
        N_("Installed but unused by any site. Safer to remove since they remain "
          "selectable in the panel."),
        N_("Remove unused EOL versions."),
        "eol-php-kaldir",
    )]


def guvenlik_duvari_portlari():
    """
    Güvenlik duvarının GERÇEKTEN dışarıya açtığı portlar.

    Yalnızca dinleyen soketlere (`ss`) bakmak yanıltır: Apache 8080/8443'te
    dinler ama güvenlik duvarı kapalıdır, dışarıdan erişilemez. Bunları
    "açık port" diye bildirmek yanlış alarmdır ve aracın güvenilirliğini
    bitirir. (Ölçüldü: 8080/8443 dışarıdan kapalı.)
    """
    rc, out, _ = kabuk([HESTIA + "/bin/v-list-firewall", "json"])
    portlar = set()
    araliklar = set()
    try:
        for _, k in (json.loads(out) if out else {}).items():
            if k.get("ACTION") != "ACCEPT" or k.get("PROTOCOL", "TCP") == "UDP":
                continue
            for parca in str(k.get("PORT", "")).split(","):
                parca = parca.strip()
                if "-" in parca:
                    # Aralıklar TEK parça olarak tutulur. FTP pasif aralığı
                    # (12000-12100) tek tek listelenirse 101 satırlık gürültü
                    # olur ve gerçek bulguyu gömer.
                    a, b = parca.split("-", 1)
                    if a.isdigit() and b.isdigit():
                        araliklar.add((int(a), int(b)))
                elif parca.isdigit() and int(parca) > 0:
                    portlar.add(int(parca))
    except Exception:
        return None, None
    return portlar, araliklar


# Bilinen ama dikkat gerektiren servisler. — metinler runtime'da çevrilir
DIKKAT_PORT = {
    21: ("Plain FTP",
         "FTP sends passwords unencrypted; anyone on the network can read them.",
         "Disable FTP if clients can use SFTP.", "ftp-kapat"),
    8085: ("Web Terminal",
           "A service that opens a root shell from the browser is exposed to the "
           "world. It is a legitimate HestiaCP service but has a large attack surface.",
           "If unused, disable: v-change-sys-config-value "
           "WEB_TERMINAL 'false' — or open it in the firewall only to your own IP.",
           None),
}


def port_kontrolu():
    ck = []
    fw, araliklar = guvenlik_duvari_portlari()
    if fw is None:
        return [kontrol("port", N_("Open ports"), "bilinmiyor",
                        N_("firewall list could not be read"))]

    for p, (ad, note, cozum, islem) in DIKKAT_PORT.items():
        if p in fw:
            ck.append(kontrol("port_%d" % p, N_("%s (port %d)") % (_(ad), p),
                              "warn", N_("open externally"), _(note), _(cozum), islem))

    hepsi = sorted(fw) + ["%d-%d" % a for a in sorted(araliklar)]
    beklenmeyen = sorted(fw - BEKLENEN_PORT - set(DIKKAT_PORT))
    if beklenmeyen:
        ck.append(kontrol(
            "port", N_("Unexpected open port"), "warn",
            ", ".join(str(x) for x in beklenmeyen),
            N_("The firewall is exposing these ports externally."),
            N_("Close them in Panel > Firewall if not needed."),
        ))
    else:
        ck.append(kontrol("port", N_("Open ports"), "ok",
                          ", ".join(str(x) for x in hepsi)))
    return ck


def dosya_kontrolu():
    rc, out, _ = kabuk(["bash", "-c",
                        "find /home/*/web/*/public_html -perm -o+w -type f 2>/dev/null | head -50"],
                       timeout=120)
    dosyalar = [s for s in out.splitlines() if s.strip()]
    if dosyalar:
        return [kontrol(
            "dosya_izin", N_("World-writable files"), "fail",
            ngettext("%d file", "%d files", len(dosyalar)) % len(dosyalar),
            N_("Any local user on the server can modify these files."),
            N_("Fix permissions: chmod o-w <file>"),
        )]
    return [kontrol("dosya_izin", N_("File permissions"), "ok",
                    N_("no world-writable files"))]


# ------------------------------------------------------------- toplama
def topla():
    ck = []
    ck += ssh_kontrolleri()
    ck += panel_kontrolleri()
    ck += fail2ban_kontrolleri()
    ck += guncelleme_kontrolu()
    ck += php_kontrolu()
    ck += port_kontrolu()
    ck += dosya_kontrolu()

    ozet = {"ok": 0, "warn": 0, "fail": 0, "bilinmiyor": 0}
    for c in ck:
        ozet[c["durum"]] = ozet.get(c["durum"], 0) + 1

    return {"ts": int(time.time()), "kontroller": ck,
            "saldirganlar": saldirganlar(), "ozet": ozet}


def yaz(d):
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    g = CACHE + ".tmp"
    with open(g, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False)
    os.replace(g, CACHE)
    os.chmod(CACHE, 0o644)


# --------------------------------------------------------- sertleştirme
def sshd_yaz(satirlar, kuru=False):
    """
    sshd_config.d parçasını yazar, DOĞRULAR, geçersizse geri alır.
    `reload` kullanılır: mevcut SSH oturumları düşmez.
    """
    if kuru:
        print("  [kuru] %s icerigi:\n%s" % (SSHD_WD, satirlar))
        return True, "kuru"

    eski = None
    if os.path.isfile(SSHD_WD):
        with open(SSHD_WD, encoding="utf-8") as fh:
            eski = fh.read()

    os.makedirs(os.path.dirname(SSHD_WD), exist_ok=True)
    with open(SSHD_WD, "w", encoding="utf-8") as fh:
        fh.write(satirlar)
    os.chmod(SSHD_WD, 0o644)

    rc, _, err = kabuk(["sshd", "-t"])
    if rc != 0:
        if eski is None:
            os.unlink(SSHD_WD)
        else:
            with open(SSHD_WD, "w", encoding="utf-8") as fh:
                fh.write(eski)
        return False, N_("sshd validation failed: ") + err.strip()[:200]

    kabuk(["systemctl", "reload", "ssh"])
    kabuk(["systemctl", "reload", "sshd"])
    return True, N_("applied")


def mevcut_sshd_parca():
    if os.path.isfile(SSHD_WD):
        with open(SSHD_WD, encoding="utf-8") as fh:
            return fh.read()
    return ""


def parca_guncelle(anahtar, deger):
    """Var olan parçadaki anahtarı değiştirir, yoksa ekler."""
    icerik = mevcut_sshd_parca()
    satirlar = [s for s in icerik.splitlines()
                if not re.match(r"^\s*%s\b" % re.escape(anahtar), s, re.I)]
    if not satirlar or not satirlar[0].startswith("#"):
        satirlar.insert(0, "# WebDanismani - guvenlik sertlestirme")
    satirlar.append("%s %s" % (anahtar, deger))
    return "\n".join(satirlar) + "\n"


def uygula(islem, kuru=False):
    if islem == "ssh-parola-kapat":
        # Ön koşul: GİRİŞ YAPABİLEN bir hesapta anahtar olmalı.
        anahtarlar = ssh_anahtarlari(yalniz_girisebilen=True)
        if not anahtarlar:
            return hata_yaz(
                N_("No login-capable account has an SSH key (keys on nologin "
                  "shells do not count). Disabling password login would lock "
                  "you out completely. Add a working key first and verify "
                  "you can connect."))
        ok, mesaj = sshd_yaz(parca_guncelle("PasswordAuthentication", "no"), kuru)
        return sonuc_yaz(ok, mesaj, {"anahtarlar": anahtarlar})

    if islem == "ssh-root-kapat":
        # Ön koşul: root DIŞINDA, anahtarı olan + kabuğu geçerli + sudo yetkili
        # bir hesap. Üçü birden sağlanmazsa sunucu yönetilemez hâle gelir.
        adaylar = {k: v for k, v in ssh_anahtarlari(yalniz_girisebilen=True).items()
                   if k != "root" and sudo_yetkili(k)}
        if not adaylar:
            return hata_yaz(
                N_("No non-root account has an SSH key, a valid shell, AND sudo. "
                  "Disabling root login would leave the server unmanageable. "
                  "Create such a user first and verify you can connect with it."))
        ok, mesaj = sshd_yaz(parca_guncelle("PermitRootLogin", "no"), kuru)
        return sonuc_yaz(ok, mesaj, {"adaylar": adaylar})

    if islem == "ftp-kapat":
        if kuru:
            return sonuc_yaz(True, N_("dry-run: vsftpd will be stopped and disabled"))
        kabuk(["systemctl", "stop", "vsftpd"])
        kabuk(["systemctl", "disable", "vsftpd"])
        kabuk([HESTIA + "/bin/v-delete-firewall-rule", "1"]) if False else None
        rc, out, _ = kabuk(["systemctl", "is-active", "vsftpd"])
        return sonuc_yaz(out.strip() != "active",
                         N_("vsftpd status: ") + out.strip())

    if islem == "eol-php-kaldir":
        kurulu = sorted(os.listdir("/etc/php")) if os.path.isdir("/etc/php") else []
        hedef = []
        for v in kurulu:
            if v not in EOL_PHP:
                continue
            desen = "PHP-" + v.replace(".", "_")
            rc, out, _ = kabuk(["bash", "-c",
                                "grep -l %s %s/data/users/*/web.conf 2>/dev/null | wc -l"
                                % (desen, HESTIA)])
            if out.strip() in ("", "0"):
                hedef.append(v)
        if not hedef:
            return hata_yaz(N_("No unused EOL PHP versions that can be removed."))
        if kuru:
            return sonuc_yaz(True, N_("dry-run: will remove -> ") + ", ".join(hedef))
        for v in hedef:
            kabuk([HESTIA + "/bin/v-delete-web-php", v], timeout=300)
        return sonuc_yaz(True, N_("removed: ") + ", ".join(hedef))

    return hata_yaz(N_("Unknown action: ") + islem)


def hata_yaz(mesaj):
    print(json.dumps({"ok": False, "hata": mesaj}, ensure_ascii=False))
    return 1


def sonuc_yaz(ok, mesaj, ek=None):
    d = {"ok": ok, "mesaj": mesaj}
    if ek:
        d.update(ek)
    print(json.dumps(d, ensure_ascii=False))
    return 0 if ok else 1


def main():
    mod = sys.argv[1] if len(sys.argv) > 1 else "json"

    if mod == "refresh":
        d = topla()
        yaz(d)
        print(json.dumps({"ok": True, "ozet": d["ozet"]}, ensure_ascii=False))
        return 0

    if mod == "uygula":
        if len(sys.argv) < 3:
            return hata_yaz(N_("Action not specified."))
        r = uygula(sys.argv[2], "--kuru" in sys.argv)
        if "--kuru" not in sys.argv:
            yaz(topla())
        return r

    d = None
    try:
        with open(CACHE, encoding="utf-8") as fh:
            d = json.load(fh)
    except Exception:
        pass
    if d is None or (time.time() - d.get("ts", 0)) > 3600:
        d = topla()
        yaz(d)

    if mod == "plain":
        o = d["ozet"]
        print(N_("security: %d errors, %d warnings, %d ok")
              % (o.get("fail", 0), o.get("warn", 0), o.get("ok", 0)))
        for c in d["kontroller"]:
            if c["durum"] in ("fail", "warn"):
                print("  [%-4s] %-26s %s" % (c["durum"], c["label"], c["deger"]))
        for s in d.get("saldirganlar", [])[:5]:
            print(N_("  attacker: %-16s %d attempts") % (s["ip"], s["deneme"]))
        return 0

    print(json.dumps(d, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
