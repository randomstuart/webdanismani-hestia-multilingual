#!/usr/bin/env python3
"""
WebDanışmanı — Health Center collector

Installs to: /usr/local/hestia/wd/bin/wd-health
Called from the panel via sudo (/etc/sudoers.d/wd-panel).

WHAT IT DOES
  Compares records INSIDE the panel with what DNS actually shows from OUTSIDE.
  If HestiaCP says "DKIM on" but the record was never published, mail still
  fails — that gap is exactly what these checks catch.

CHECKS
  Server : PTR (rDNS), Exim queue, frozen mail, blacklists (RBL)
  Mail   : SPF, DKIM, DMARC, MX
  Web    : A record, SSL certificate expiry

DESIGN NOTES
  * Each check returns {durum, deger, not, cozum}. "cozum" tells the user what
    to do — reporting a problem alone is not enough.
  * Spamhaus 127.255.255.x = "query refused" (public resolver block),
    NOT a blacklist hit. A naive check false-alarms here.
  * Results are written to cache; the panel reads cache, cron refreshes.
    DNS queries are slow, so live queries are not done on page open.

Usage:
  wd-health json [max_age_sec]   read cache, refresh if stale
  wd-health refresh              force refresh (cron)
  wd-health plain                short text summary
"""

import json
import os
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

import sys as _wd_sys
_wd_lib = "/usr/local/hestia/wd/lib"
if _wd_lib not in _wd_sys.path:
    _wd_sys.path.insert(0, _wd_lib)
_wd_pkg = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib")
if os.path.isdir(_wd_pkg) and _wd_pkg not in _wd_sys.path:
    _wd_sys.path.insert(0, _wd_pkg)
from wd_i18n import _, ngettext  # noqa: E402
N_ = lambda s: s  # mark for .po extract; translate in PHP (cached JSON)

HESTIA = "/usr/local/hestia"
CACHE = HESTIA + "/wd/cache/health.json"
DIG_ARGS = ["+short", "+time=2", "+tries=1"]

# Sorgulanacak kara listeler. Spamhaus genel çözümleyicileri engellediği için
# yanıtı ayrıca yorumlanır (bkz. rbl_kontrol).
RBL = [
    ("zen.spamhaus.org", "Spamhaus ZEN"),
    ("bl.spamcop.net", "SpamCop"),
    ("b.barracudacentral.org", "Barracuda"),
]


# ---------------------------------------------------------------- yardımcılar
def kabuk(cmd, timeout=15):
    """Komutu çalıştırır, stdout döner. Hata/timeout -> boş string."""
    try:
        r = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
        return r.stdout.strip()
    except Exception:
        return ""


def dig(*args, timeout=8):
    return kabuk(["dig"] + DIG_ARGS + list(args), timeout=timeout)


def dig_satirlar(*args):
    out = dig(*args)
    return [s.strip() for s in out.splitlines() if s.strip()]


def txt_birlestir(satirlar):
    """dig TXT çıktısındaki tırnakları temizler; uzun kayıtlar parçalı gelir."""
    out = []
    for s in satirlar:
        out.append(re.sub(r'"\s+"', "", s).strip('"'))
    return out


def v(*args):
    """HestiaCP CLI, JSON döner."""
    out = kabuk([HESTIA + "/bin/" + args[0]] + list(args[1:]) + ["json"])
    try:
        return json.loads(out) if out else {}
    except ValueError:
        return {}


def kontrol(kid, label, durum, deger="", note="", cozum=""):
    return {
        "id": kid,
        "label": label,
        "durum": durum,  # ok | warn | fail | bilinmiyor
        "deger": deger,
        "not": note,
        "cozum": cozum,
    }


# ------------------------------------------------------------ sunucu düzeyi
def ptr_kontrol(ip, hostname):
    ptr = dig("-x", ip).rstrip(".")
    if not ptr:
        return kontrol(
            "ptr", N_("Reverse DNS (PTR)"), "fail", "—",
            N_("No PTR record."),
            N_("Set reverse DNS (rDNS/PTR) in your provider console: "
              "%s -> %s") % (ip, hostname),
        )
    if ptr.lower() == hostname.lower():
        return kontrol("ptr", N_("Reverse DNS (PTR)"), "ok", ptr)
    return kontrol(
        "ptr", N_("Reverse DNS (PTR)"), "fail", ptr,
        N_("PTR does not match the server hostname; many providers reject this mail."),
        N_("Set reverse DNS (rDNS/PTR) in your provider console: "
          "%s -> %s") % (ip, hostname),
    )


def rbl_kontrol(ip):
    """
    Kara liste sorgusu.

    ÖNEMLİ: Bir RBL'den 127.x.x.x yanıtı almak her zaman "listede" demek
    değildir. Spamhaus, genel çözümleyicilerden (Google DNS vb.) gelen
    sorguları 127.255.255.x ile REDDEDER. Bunu listeleme sayan naif bir
    kontrol her sunucuyu kara listede gösterirdi.
    """
    ters = ".".join(reversed(ip.split(".")))
    listelenen, engellenen, temiz = [], [], []
    kanit = []

    for zone, ad in RBL:
        yanit = dig("A", "%s.%s" % (ters, zone))
        if not yanit:
            temiz.append(ad)
            continue
        ilk = yanit.splitlines()[0].strip()
        if ilk.startswith("127.255.255."):
            engellenen.append(ad)
        elif ilk.startswith("127."):
            listelenen.append(ad)
            # Sebep/çıkarma bağlantısı çoğu listede TXT kaydında döner.
            txt = dig("TXT", "%s.%s" % (ters, zone))
            for satir in txt.splitlines():
                satir = satir.strip().strip('"')
                if satir.startswith("http"):
                    kanit.append("%s: %s" % (ad, satir))
                    break
        else:
            temiz.append(ad)

    ek = ""
    if engellenen:
        ek = N_(" %s could not be queried (resolver block) — does not mean you are listed.") % ", ".join(engellenen)

    if listelenen:
        return kontrol(
            "rbl", N_("Blacklist (RBL)"), "fail", ", ".join(listelenen),
            N_("Server IP is on a blacklist; providers that use these lists "
              "will reject your mail.") + ek,
            (N_("Open a delisting request. ") + " · ".join(kanit))
            if kanit else N_("Open a delisting request on the list's website."),
        )

    if engellenen and not temiz:
        return kontrol(
            "rbl", N_("Blacklist (RBL)"), "bilinmiyor", N_("could not query"),
            N_("The resolver cannot query these lists (public DNS block). "
              "This does NOT mean you are listed."),
            N_("For a definitive result, install a local resolver on the server "
              "or use the list's own lookup page."),
        )

    return kontrol(
        "rbl", N_("Blacklist (RBL)"),
        "warn" if engellenen else "ok",
        N_("clean: ") + ", ".join(temiz),
        (N_("Checked lists are clean.") + ek) if engellenen else "",
    )


def kuyruk_kontrol():
    bekleyen = kabuk(["exim4", "-bpc"]) or "0"
    try:
        bekleyen = int(bekleyen)
    except ValueError:
        bekleyen = 0
    donmus = 0
    if bekleyen:
        donmus = kabuk(["bash", "-c", "exim4 -bp | grep -c frozen"]) or "0"
        try:
            donmus = int(donmus)
        except ValueError:
            donmus = 0

    ck = [kontrol("kuyruk", N_("Mail queue"), "ok",
                  ngettext("%d waiting", "%d waiting", bekleyen) % bekleyen)]
    if bekleyen > 50:
        ck[0] = kontrol(
            "kuyruk", N_("Mail queue"), "warn",
            ngettext("%d waiting", "%d waiting", bekleyen) % bekleyen,
            N_("Queue is building up; there may be a delivery problem."),
        )
    if donmus:
        ck.append(kontrol(
            "donmus", N_("Frozen mail"), "warn",
            ngettext("%d message", "%d messages", donmus) % donmus,
            N_("There are frozen messages that could not be delivered."),
            N_("On the server: exim4 -bpru | awk '{print $3}' | xargs -r exim4 -Mrm"),
        ))
    return ck


# -------------------------------------------------------------- mail alan adı
def spf_kontrol(domain, ip):
    kayitlar = [t for t in txt_birlestir(dig_satirlar("TXT", domain))
                if t.lower().startswith("v=spf1")]
    if not kayitlar:
        return kontrol(
            "spf", "SPF", "fail", "—",
            N_("No SPF record; your mail will go to spam."),
            N_('Add a TXT record in DNS: "v=spf1 +a +mx +ip4:%s ~all"') % ip,
        )
    if len(kayitlar) > 1:
        return kontrol(
            "spf", "SPF", "fail",
            ngettext("%d record", "%d records", len(kayitlar)) % len(kayitlar),
            N_("Multiple SPF records are invalid; all are ignored."),
            N_("Leave only one SPF TXT record."),
        )
    kayit = kayitlar[0]
    yetkili = ("ip4:" + ip) in kayit or re.search(r"[+ ]a\b", kayit) or re.search(r"[+ ]mx\b", kayit)
    if not yetkili:
        return kontrol(
            "spf", "SPF", "warn", kayit,
            N_("SPF does not appear to authorize this server."),
            N_("Add ip4:%s to the record.") % ip,
        )
    return kontrol("spf", "SPF", "ok", kayit)


def dkim_kontrol(user, domain):
    # Panelin ürettiği DKIM kaydı
    ham = kabuk([HESTIA + "/bin/v-list-mail-domain-dkim-dns", user, domain])
    m = re.search(r'p=([A-Za-z0-9+/=]+)', ham)
    beklenen = m.group(1) if m else None

    yayinda = txt_birlestir(dig_satirlar("TXT", "mail._domainkey." + domain))
    yayinda = [t for t in yayinda if "DKIM1" in t or "p=" in t]

    if not beklenen:
        return kontrol(
            "dkim", "DKIM", "warn", "—",
            N_("No DKIM key has been generated for this domain."),
            N_("Panel > Mail > edit domain > enable DKIM."),
        )
    if not yayinda:
        return kontrol(
            "dkim", "DKIM", "fail", "—",
            N_("DKIM is enabled in the panel but the record is MISSING in DNS; "
              "signatures cannot be verified."),
            N_("Add the mail._domainkey.%s TXT record to DNS "
              "(same value as Panel > Mail > DKIM).") % domain,
        )
    m2 = re.search(r'p=([A-Za-z0-9+/=]+)', yayinda[0])
    canli = m2.group(1) if m2 else ""
    if canli != beklenen:
        return kontrol(
            "dkim", "DKIM", "fail", N_("mismatch"),
            N_("The DKIM key in DNS differs from the panel; signatures cannot be verified."),
            N_("Replace the mail._domainkey.%s record in DNS with the value "
              "from the panel.") % domain,
        )
    return kontrol("dkim", "DKIM", "ok", N_("published and matching"))


def dmarc_kontrol(domain):
    kayitlar = [t for t in txt_birlestir(dig_satirlar("TXT", "_dmarc." + domain))
                if t.lower().startswith("v=dmarc1")]
    if not kayitlar:
        return kontrol(
            "dmarc", "DMARC", "warn", "—",
            N_("No DMARC record; spoofed mail can be sent in your domain's name."),
            '_dmarc.%s TXT: "v=DMARC1; p=quarantine; pct=100"' % domain,
        )
    return kontrol("dmarc", "DMARC", "ok", kayitlar[0])


def mx_kontrol(domain, ip):
    satirlar = dig_satirlar("MX", domain)
    if not satirlar:
        return kontrol(
            "mx", "MX", "fail", "—",
            N_("No MX record; external mail will NOT arrive for this domain."),
            N_("Add an MX record in DNS: 10 mail.%s") % domain,
        )
    hedefler = []
    bizde = False
    for s in satirlar:
        p = s.split()
        host = (p[-1] if p else "").rstrip(".")
        if not host:
            continue
        hedefler.append(host)
        adres = dig_satirlar("A", host)
        if ip in adres:
            bizde = True
    if not hedefler:
        return kontrol("mx", "MX", "fail", "—", N_("MX could not be resolved."))
    if not bizde:
        cozulmeyen = [h for h in hedefler if not dig_satirlar("A", h)]
        if cozulmeyen:
            return kontrol(
                "mx", "MX", "fail", ", ".join(hedefler),
                N_("MX target does not resolve (%s); mail cannot be delivered.")
                % ", ".join(cozulmeyen),
                N_("Fix the MX record: 10 mail.%s (do not write the domain twice).")
                % domain,
            )
        return kontrol(
            "mx", "MX", "warn", ", ".join(hedefler),
            N_("MX does not point to this server; mail is going elsewhere."),
            N_("If mail should stay on this server, set MX to mail.%s.") % domain,
        )
    return kontrol("mx", "MX", "ok", ", ".join(hedefler))


# --------------------------------------------------------------- web alan adı
# ------------------------------------------------------------------- yedekler
YEDEK_DIZIN = "/backup"


def yedek_kontrol(user):
    """
    Yedek sağlığı.

    NEDEN: HestiaCP yedeği ALIR ama geri yüklenebilir mi diye BAKMAZ. Hosting
    işinde en kötü senaryo "yedek var ama açılmıyor" — ve bu ancak felaket
    anında fark edilir. Burada üç şey denetlenir:
      1. Yedek var mı ve ne kadar taze
      2. Arşiv gerçekten okunabiliyor mu (tar içindekiler listelenebiliyor mu)
      3. Boyut aniden düştü mü (veri kaybının erken sinyali)
    """
    kayit = v("v-list-user-backups", user)
    if not isinstance(kayit, dict) or not kayit:
        return [kontrol(
            "yedek_yok", N_("Backup"), "fail", "—",
            N_("This account has no backups."),
            N_("Panel > Backups > Create Backup; or on the server: v-backup-user %s") % user,
        )]

    # Tarihe göre sırala (en yeni önce)
    def zaman(v_):
        return (v_.get("DATE", ""), v_.get("TIME", ""))

    sirali = sorted(kayit.items(), key=lambda kv: zaman(kv[1]), reverse=True)
    en_yeni_ad, en_yeni = sirali[0]

    ck = []

    # --- 1) Tazelik ---
    yas_saat = None
    try:
        ts = time.mktime(time.strptime(
            en_yeni.get("DATE", "") + " " + en_yeni.get("TIME", ""),
            "%Y-%m-%d %H:%M:%S"))
        yas_saat = (time.time() - ts) / 3600.0
    except Exception:
        pass

    tarih_str = "%s %s" % (en_yeni.get("DATE", "?"), en_yeni.get("TIME", "?")[:5])
    if yas_saat is None:
        ck.append(kontrol("yedek_yas", N_("Latest backup"), "bilinmiyor", tarih_str,
                          N_("Backup date could not be read.")))
    elif yas_saat > 48:
        ck.append(kontrol(
            "yedek_yas", N_("Latest backup"), "fail",
            N_("%s (%d hours ago)") % (tarih_str, int(yas_saat)),
            N_("Backup is older than 48 hours; daily backups may not be running."),
            N_("Check on the server: grep backup /etc/cron.d/hestia"),
        ))
    elif yas_saat > 26:
        ck.append(kontrol(
            "yedek_yas", N_("Latest backup"), "warn",
            N_("%s (%d hours ago)") % (tarih_str, int(yas_saat)),
            N_("Latest backup is more than a day old."),
        ))
    else:
        ck.append(kontrol("yedek_yas", N_("Latest backup"), "ok",
                          N_("%s (%d hours ago)") % (tarih_str, int(yas_saat))))

    # --- 2) Arşiv okunabiliyor mu ---
    # `tar -tf` arşivi AÇMADAN içindekileri listeler; bozuk arşiv burada
    # hata verir. Büyük yedeklerde uzun sürebileceği için zaman sınırı var.
    yol = os.path.join(YEDEK_DIZIN, en_yeni_ad)
    if not os.path.isfile(yol):
        ck.append(kontrol(
            "yedek_dosya", N_("Archive file"), "warn", en_yeni_ad,
            N_("Backup record exists but the file was not found under %s "
              "(it may have been moved to remote storage).") % YEDEK_DIZIN,
        ))
    else:
        rc, out, err = 1, "", ""
        try:
            r = subprocess.run(["tar", "-tf", yol], capture_output=True,
                               text=True, timeout=120)
            rc, out, err = r.returncode, r.stdout, r.stderr
        except subprocess.TimeoutExpired:
            rc = 124
        except Exception as e:
            rc, err = 1, str(e)

        if rc == 124:
            ck.append(kontrol("yedek_butunluk", N_("Archive integrity"), "bilinmiyor",
                              N_("timeout"),
                              N_("Archive could not be listed within 120 seconds; it may be very large.")))
        elif rc != 0:
            ck.append(kontrol(
                "yedek_butunluk", N_("Archive integrity"), "fail", N_("CORRUPT"),
                N_("Backup archive cannot be read: %s") % (err.strip()[:120] or N_("tar error")),
                N_("This backup cannot be restored. Take a new backup and delete the corrupt one."),
            ))
        else:
            adet = len([s for s in out.splitlines() if s.strip()])
            ck.append(kontrol("yedek_butunluk", N_("Archive integrity"), "ok",
                              ngettext("%d entry", "%d entries", adet) % adet))

    # --- 3) Boyut düşüşü ---
    # Bir müşterinin yedeği aniden küçüldüyse ya veri silinmiştir ya da
    # yedekleme yarım kalmıştır; ikisi de sessizce olur.
    if len(sirali) >= 2:
        try:
            yeni_mb = float(en_yeni.get("SIZE", 0))
            onceki_mb = float(sirali[1][1].get("SIZE", 0))
            if onceki_mb >= 5 and yeni_mb < onceki_mb * 0.5:
                ck.append(kontrol(
                    "yedek_boyut", N_("Backup size"), "warn",
                    N_("%.0f MB (previous %.0f MB)") % (yeni_mb, onceki_mb),
                    N_("Latest backup is less than half the previous one; data loss "
                      "or an incomplete backup is possible."),
                    N_("Compare backup contents; take a manual backup if needed."),
                ))
            else:
                ck.append(kontrol("yedek_boyut", N_("Backup size"), "ok",
                                  "%.0f MB" % yeni_mb))
        except (TypeError, ValueError):
            pass

    return ck


def ns_kontrol(domain, sunucu_ipleri):
    """
    Alan adının DNS'i BU SUNUCUDA mı yönetiliyor?

    NEDEN ÖNEMLİ: Panelde bir DNS bölgesi görünüyor olması, alan adının
    gerçekten o bölgeyi kullandığı anlamına GELMEZ. Kayıt kuruluşundaki
    nameserver'lar başka bir sağlayıcıyı gösteriyorsa, paneldeki bölge
    tamamen yok sayılır. Bu ayrımı yapmadan "DNS kayıtlarını aç" demek
    kullanıcıyı hiçbir etkisi olmayan bir düzenlemeye yönlendirir.

    Dönen: (ns listesi, bu_sunucuda mı)
    """
    ns = [s.rstrip(".") for s in dig_satirlar("NS", domain)]
    if not ns:
        # Alt alan adlarının kendi NS'i olmaz; üst alan adına bakılır.
        parca = domain.split(".")
        if len(parca) > 2:
            ns = [s.rstrip(".") for s in dig_satirlar("NS", ".".join(parca[-2:]))]
    if not ns:
        return [], None

    for n in ns:
        for adres in dig_satirlar("A", n):
            if adres in sunucu_ipleri:
                return ns, True
    return ns, False


def a_kontrol(domain, ip):
    adres = dig_satirlar("A", domain)
    if not adres:
        return kontrol(
            "a", N_("A record"), "fail", "—",
            N_("Domain does not resolve to any IP."),
            N_("Add an A record in DNS: %s -> %s") % (domain, ip),
        )
    if ip in adres:
        return kontrol("a", N_("A record"), "ok", ", ".join(adres))
    return kontrol(
        "a", N_("A record"), "warn", ", ".join(adres),
        N_("Domain points to another server; the site is not published from here."),
        N_("If you will host the domain here, set the A record to %s.") % ip,
    )


def ssl_kontrol(user, domain, le_acik):
    yol = "/home/%s/conf/web/%s/ssl/%s.crt" % (user, domain, domain)
    if not os.path.isfile(yol):
        if le_acik:
            return kontrol(
                "ssl", "SSL", "fail", "—",
                N_("SSL appears enabled but the certificate file is missing."),
                N_("Panel > Web > edit domain > save SSL again."),
            )
        return kontrol(
            "ssl", "SSL", "warn", N_("off"),
            N_("No certificate; the site will not open over https://."),
            N_("Panel > Web > edit domain > enable Let's Encrypt."),
        )
    son = kabuk(["openssl", "x509", "-enddate", "-noout", "-in", yol])
    m = re.search(r"notAfter=(.+)", son)
    if not m:
        return kontrol("ssl", "SSL", "bilinmiyor", N_("could not read"))
    try:
        bitis = time.mktime(time.strptime(m.group(1).strip(), "%b %d %H:%M:%S %Y %Z"))
    except ValueError:
        return kontrol("ssl", "SSL", "bilinmiyor", m.group(1).strip())
    kalan = int((bitis - time.time()) // 86400)
    tarih = time.strftime("%d.%m.%Y", time.localtime(bitis))
    if kalan < 0:
        return kontrol(
            "ssl", "SSL", "fail", N_("expired (%s)") % tarih,
            N_("Certificate has expired; browsers will show a warning."),
            N_("Panel > Web > edit domain > save SSL again."),
        )
    if kalan < 14:
        return kontrol(
            "ssl", "SSL", "warn", N_("%d days (%s)") % (kalan, tarih),
            N_("Automatic renewal may not have run."),
            N_("Trigger renewal manually: v-update-letsencrypt-ssl"),
        )
    return kontrol("ssl", "SSL", "ok", N_("%d days (%s)") % (kalan, tarih))


# ------------------------------------------------------------------- toplayıcı
def topla():
    hostname = kabuk(["hostname", "-f"]) or kabuk(["hostname"])
    cfg = v("v-list-sys-config")
    ip = ""
    ipler = v("v-list-sys-ips")
    if isinstance(ipler, dict) and ipler:
        ip = list(ipler.keys())[0]
    if not ip:
        ip = kabuk(["bash", "-c", "hostname -I | awk '{print $1}'"])

    kullanicilar = v("v-list-users")
    if not isinstance(kullanicilar, dict):
        kullanicilar = {}

    # --- sunucu ---
    sunucu = [ptr_kontrol(ip, hostname)]
    sunucu += kuyruk_kontrol()
    sunucu.append(rbl_kontrol(ip))

    # --- alan adları ---
    mail_isleri, web_isleri = [], []
    for user in kullanicilar:
        for d, bilgi in (v("v-list-mail-domains", user) or {}).items():
            mail_isleri.append((user, d, bilgi))
        for d, bilgi in (v("v-list-web-domains", user) or {}).items():
            web_isleri.append((user, d, bilgi))

    # Sunucunun kendi IP'leri: NS'in buraya işaret edip etmediğini anlamak için.
    sunucu_ipleri = set()
    if isinstance(ipler, dict):
        sunucu_ipleri.update(ipler.keys())
    if ip:
        sunucu_ipleri.add(ip)

    ns_onbellek = {}

    def ns_bilgi(domain):
        if domain not in ns_onbellek:
            ns_onbellek[domain] = ns_kontrol(domain, sunucu_ipleri)
        return ns_onbellek[domain]

    def mail_isle(t):
        user, d, bilgi = t
        ns, bizde = ns_bilgi(d)
        return {
            "domain": d,
            "user": user,
            "askida": (bilgi.get("SUSPENDED") == "yes"),
            "ns": ns,
            "dns_disarida": (bizde is False),
            "checks": [
                mx_kontrol(d, ip),
                spf_kontrol(d, ip),
                dkim_kontrol(user, d),
                dmarc_kontrol(d),
            ],
        }

    def web_isle(t):
        user, d, bilgi = t
        le = bilgi.get("LETSENCRYPT") == "yes" or bilgi.get("SSL") == "yes"
        ns, bizde = ns_bilgi(d)
        return {
            "domain": d,
            "user": user,
            "askida": (bilgi.get("SUSPENDED") == "yes"),
            "ns": ns,
            "dns_disarida": (bizde is False),
            "checks": [a_kontrol(d, ip), ssl_kontrol(user, d, le)],
        }

    with ThreadPoolExecutor(max_workers=8) as ex:
        mail = list(ex.map(mail_isle, mail_isleri))
        web = list(ex.map(web_isle, web_isleri))

    mail.sort(key=lambda x: x["domain"])
    web.sort(key=lambda x: x["domain"])

    # --- Yedekler (kullanıcı başına) ---
    yedek = []
    for user in kullanicilar:
        yedek.append({"user": user, "checks": yedek_kontrol(user)})
    yedek.sort(key=lambda x: x["user"])

    ozet = {"ok": 0, "warn": 0, "fail": 0, "bilinmiyor": 0}
    for c in sunucu:
        ozet[c["durum"]] = ozet.get(c["durum"], 0) + 1
    for grup in (mail, web, yedek):
        for d in grup:
            for c in d["checks"]:
                ozet[c["durum"]] = ozet.get(c["durum"], 0) + 1

    return {
        "ts": int(time.time()),
        "hostname": hostname,
        "ip": ip,
        "sunucu": sunucu,
        "mail": mail,
        "web": web,
        "yedek": yedek,
        "ozet": ozet,
    }


def yaz(data):
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    gecici = CACHE + ".tmp"
    with open(gecici, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(gecici, CACHE)
    os.chmod(CACHE, 0o644)


def oku():
    try:
        with open(CACHE, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def main():
    mod = sys.argv[1] if len(sys.argv) > 1 else "json"

    if mod == "refresh":
        data = topla()
        yaz(data)
        print(json.dumps({"ok": True, "ts": data["ts"], "ozet": data["ozet"]}))
        return

    try:
        azami = int(sys.argv[2]) if len(sys.argv) > 2 else 900
    except ValueError:
        azami = 900

    data = oku()
    if data is None or (time.time() - data.get("ts", 0)) > azami:
        data = topla()
        yaz(data)

    if mod == "plain":
        o = data["ozet"]
        print(N_("issues: %d errors, %d warnings  (last check %s)")
              % (o.get("fail", 0), o.get("warn", 0),
                 time.strftime("%d.%m.%Y %H:%M", time.localtime(data["ts"]))))
        for c in data["sunucu"]:
            if c["durum"] in ("fail", "warn"):
                print("  [%s] %s: %s" % (c["durum"], c["label"], c["deger"]))
        for grup, ad in ((data["mail"], "mail"), (data["web"], "web")):
            for d in grup:
                for c in d["checks"]:
                    if c["durum"] in ("fail", "warn"):
                        print("  [%s] %s %s %s: %s"
                              % (c["durum"], ad, d["domain"], c["label"], c["deger"]))
        for y in data.get("yedek", []):
            for c in y["checks"]:
                if c["durum"] in ("fail", "warn"):
                    print(N_("  [%s] backup %s %s: %s")
                          % (c["durum"], y["user"], c["label"], c["deger"]))
        return

    print(json.dumps(data, ensure_ascii=False, indent=1))


if __name__ == "__main__":
    main()
